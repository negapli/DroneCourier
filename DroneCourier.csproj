<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Override with: dotnet build -p:GameDir="/path/to/Schedule I" -->
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Schedule I</GameDir>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <!-- Keep local folder names out of the built DLL (the debug-symbol path is stamped into it) -->
    <PathMap>$(MSBuildProjectDirectory)=DroneCourier</PathMap>
    <SteamNetworkLibDll Condition="'$(SteamNetworkLibDll)' == ''">$(GameDir)/UserLibs/SteamNetworkLib-IL2Cpp.dll</SteamNetworkLibDll>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/MelonLoader/net6/MelonLoader.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/net6/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(GameDir)/MelonLoader/Il2CppAssemblies/*.dll" Private="false" />
    <Reference Include="$(GameDir)/Mods/S1API.Il2Cpp.MelonLoader.dll" Private="false" />
    <!-- SteamNetworkLib (ifBars) Il2Cpp build, installed from Thunderstore into <game>/UserLibs -->
    <Reference Include="$(SteamNetworkLibDll)" Private="false" />
  </ItemGroup>
  <Target Name="Deploy" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)/Mods" />
  </Target>
</Project>
